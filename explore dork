        }

        /* ---------- SECTIONS ---------- */
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 1rem 3rem;
        }

        section {
            margin-bottom: 1.25rem;
            scroll-margin-top: 140px;
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
