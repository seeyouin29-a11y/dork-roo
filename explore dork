    <!-- 1. OPERATORS -->
    <section id="operators" class="open">
        <div class="section-header" role="button" tabindex="0">
            <h3>Search Operator Reference</h3>
            <span class="chevron">▾</span>
        </div>
        <div class="section-body">
            <p class="sub">How <code>site:</code>, <code>filetype:</code>, <code>intitle:</code>, <code>inurl:</code> and related operators work.</p>

            <div class="panel">
                <h4>Core Operators</h4>
                <table class="op-table">
                    <thead>
                        <tr><th>Operator</th><th>What it does</th><th>Example</th></tr>
                    </thead>
                    <tbody>
                        <tr><td><code>site:</code></td><td>Restricts to a domain or subdomain.</td><td><code>site:example.com</code></td></tr>
                        <tr><td><code>filetype:</code></td><td>Limits to a file extension.</td><td><code>filetype:pdf</code></td></tr>
                        <tr><td><code>intitle:</code></td><td>Term must appear in page title.</td><td><code>intitle:"index of"</code></td></tr>
                        <tr><td><code>inurl:</code></td><td>Term must appear in URL.</td><td><code>inurl:admin</code></td></tr>
                        <tr><td><code>intext:</code></td><td>Term in body text.</td><td><code>intext:"password"</code></td></tr>
                        <tr><td><code>allintitle:</code></td><td>All words in title.</td><td><code>allintitle:admin login</code></td></tr>
                        <tr><td><code>allinurl:</code></td><td>All words in URL.</td><td><code>allinurl:admin login</code></td></tr>
                        <tr><td><code>related:</code></td><td>Similar sites.</td><td><code>related:example.com</code></td></tr>
                        <tr><td><code>cache:</code></td><td>Cached copy (mostly deprecated).</td><td><code>cache:example.com</code></td></tr>
                    </tbody>
                </table>
            </div>

            <div class="panel">
                <h4>Combining Operators</h4>
                <pre><code>site:example.com filetype:pdf
site:example.com intitle:"index of"
site:example.com inurl:admin intitle:login
site:example.com ext:sql OR ext:bak OR ext:log</code></pre>
            </div>

            <div class="panel">
                <h4>Boolean & Wildcards</h4>
                <ul>
                    <li><code>AND</code> — both terms (default).</li>
                    <li><code>OR</code> / <code>|</code> — either term.</li>
                    <li><code>-</code> — exclude. <code>site:x.com -inurl:blog</code></li>
                    <li><code>" "</code> — exact phrase.</li>
                    <li><code>*</code> — wildcard word.</li>
                    <li><code>..</code> — numeric range. <code>2020..2024</code></li>
                </ul>
            </div>

            <div class="panel">
                <h4>Engine Differences</h4>
                <ul>
                    <li><strong>Bing</strong> — <code>site:</code>, <code>filetype:</code>, <code>intitle:</code>, <code>inbody:</code>, <code>ip:</code>, <code>language:</code>.</li>
                    <li><strong>DuckDuckGo</strong> — <code>site:</code>, <code>filetype:</code>, <code>intitle:</code>, <code>inurl:</code>.</li>
                    <li><strong>Yandex</strong> — <code>mime:</code>, <code>host:</code>, <code>rhost:</code>, <code>domain:</code>. Strong for non-English targets.</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- 2. DORKS -->
    <section id="dorks">
        <div class="section-header" role="button" tabindex="0">
            <h3>Dorking Cheatsheet</h3>
            <span class="chevron">▾</span>
        </div>
        <div class="section-body">
            <p class="sub">Categories of dorks for finding exposed assets. Authorized use only.</p>

            <div class="danger">
                <strong>Authorized use only.</strong> Running these against systems you don't own or lack written permission to test may violate India's IT Act 2000 (Sections 43, 66) and the DPDP Act 2023.
            </div>

            <div class="panel">
                <h4>Exposed Files & Directories</h4>
                <pre><code>site:example.com intitle:"index of"
site:example.com intitle:"index of" "parent directory"
site:example.com intitle:"index of" ".env"
site:example.com intitle:"index of" "backup"</code></pre>
            </div>

            <div class="panel">
                <h4>Sensitive File Extensions</h4>
                <pre><code>site:example.com filetype:env
site:example.com filetype:sql
site:example.com filetype:log
site:example.com filetype:bak
site:example.com filetype:conf
site:example.com filetype:pem
site:example.com filetype:key</code></pre>
            </div>

            <div class="panel">
                <h4>Login & Admin Panels</h4>
                <pre><code>site:example.com inurl:admin
site:example.com inurl:login
site:example.com inurl:dashboard
site:example.com inurl:wp-admin
site:example.com inurl:phpmyadmin</code></pre>
            </div>

            <div class="panel">
                <h4>Cloud Bucket Exposure</h4>
                <pre><code>site:s3.amazonaws.com "example"
site:blob.core.windows.net "example"
site:storage.googleapis.com "example"</code></pre>
            </div>

            <div class="panel">
                <h4>Error & Debug Pages</h4>
                <pre><code>site:example.com "sql syntax near"
site:example.com "Warning: mysql_"
site:example.com "Fatal error"
site:example.com "stack trace"</code></pre>
            </div>

            <div class="panel">
